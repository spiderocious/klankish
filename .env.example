# ============================================================================
# Klankish — environment
#
# Copy to .env and fill in. The server FAILS TO BOOT on anything missing or
# malformed, which is deliberate: discovering a missing secret at the first
# request is much worse than at startup.
# ============================================================================

NODE_ENV=development
PORT=3100
HOST=0.0.0.0

# Where the browser reaches the app. Used in emails and links.
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3100

# 'all' runs API + worker + scheduler in one process (right for dev and small
# deployments). Split into 'api' / 'worker' / 'scheduler' to scale them apart —
# a config change, not a rewrite, because the queue lives in Postgres.
PROCESS_ROLE=all

# ---------------------------------------------------------------------------
# Database — the only hard dependency
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://localhost:5432/klankish_dev
PG_POOL_MAX=10

# ---------------------------------------------------------------------------
# Secrets — MUST be changed for production; the server refuses to start in
# production while these are still the dev placeholders.
# Generate with: openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=
# 32 bytes, base64. Encrypts stored secrets at rest. Losing it means every
# stored secret must be re-entered; changing it requires a key rotation.
ENCRYPTION_KEY=

ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=2592000

# ---------------------------------------------------------------------------
# Engine
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=4
# How long a worker holds a run before the reaper may reclaim it. Longer than
# your slowest step, or a live run gets re-queued underneath you.
LEASE_TTL_MS=60000
SCHEDULER_TICK_MS=5000
WORKER_POLL_MS=1000
# After downtime, a daily job fires ONCE on recovery — not 288 times.
MAX_CATCHUP_FIRES=1
RUN_DEFAULT_TIMEOUT_MS=900000
STEP_DEFAULT_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# http step
# ---------------------------------------------------------------------------
HTTP_STEP_MAX_BYTES=262144
HTTP_STEP_MAX_REDIRECTS=3
# SSRF guard. Leave false on a shared instance: it blocks loopback, private and
# link-local targets (including cloud metadata at 169.254.169.254). Turn on
# only for a self-hosted instance that must reach its own internal services.
HTTP_STEP_ALLOW_PRIVATE=false

# ---------------------------------------------------------------------------
# shell step
#
# OFF by default. A hosted multi-user instance running arbitrary commands is a
# different security posture from a personal one, so enabling it is explicit.
# Commands are spawned as argv (never a shell string), as a non-root user,
# with a scrubbed environment and a hard timeout.
# ---------------------------------------------------------------------------
SHELL_STEPS_ENABLED=false
# Optional allow-list of executable basenames, e.g. git,node,curl
SHELL_ALLOWED_BINARIES=
# Confines a step's cwd. Path traversal outside it is rejected.
SHELL_WORKSPACE_ROOT=
SHELL_MAX_OUTPUT_BYTES=1048576
SHELL_KILL_GRACE_MS=5000

# ---------------------------------------------------------------------------
# Email (optional — features degrade gracefully when unset)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM=Klankish <noreply@yourdomain.com>

# ---------------------------------------------------------------------------
# Object storage (optional) — AWS S3 or Cloudflare R2
# R2 example: https://<account-id>.r2.cloudflarestorage.com
# ---------------------------------------------------------------------------
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for R2 and most S3-compatibles; false for AWS S3 itself.
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
RATE_LIMIT_ANON_PER_MIN=30
RATE_LIMIT_USER_PER_MIN=300
RATE_LIMIT_ADMIN_PER_MIN=1000
BODY_LIMIT_BYTES=1048576
RUN_RETENTION_DAYS=90

LOG_LEVEL=info
# Serve the built SPA from the API process (one deployable instead of two).
SERVE_WEB=true
